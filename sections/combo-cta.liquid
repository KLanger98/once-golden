{% comment %}
  Combo CTA: two square, full-bleed link tiles side by side (stacked on
  mobile), each with an optional background image and a large heading centred
  in the middle.

  Lives under "Custom modules" in the theme editor's Add section picker.
{% endcomment %}

<div class="combo-cta">
  {%- for block in section.blocks -%}
    {%- liquid
      assign tag = 'div'
      if block.settings.link != blank
        assign tag = 'a'
      endif
    -%}
    <{{ tag }}
      {% if block.settings.link != blank %}
        href="{{ block.settings.link }}"
      {% endif %}
      class="combo-cta__tile"
      style="
        --combo-cta-background: {{ block.settings.background_color }};
        --combo-cta-text: {{ block.settings.text_color }};
        --combo-cta-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
      "
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'combo-cta__image',
            loading: 'lazy',
            alt: '',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '600, 900, 1200, 1600'
        }}
      {%- endif -%}

      {%- if block.settings.heading != blank -%}
        <p class="combo-cta__heading">{{ block.settings.heading }}</p>
      {%- endif -%}
    </{{ tag }}>
  {%- endfor -%}
</div>

{% stylesheet %}
  .combo-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .combo-cta__tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: var(--combo-cta-background);
    color: var(--combo-cta-text);
    text-decoration: none;
  }

  .combo-cta__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--animation-easing, ease);
  }

  /* Darkens the image behind the heading; 0 by default, as in the design. */
  .combo-cta__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-ink);
    opacity: var(--combo-cta-overlay);
    pointer-events: none;
  }

  @media (hover: hover) {
    a.combo-cta__tile:hover .combo-cta__image {
      transform: scale(1.03);
    }
  }

  a.combo-cta__tile:focus-visible {
    outline: 2px solid var(--combo-cta-text);
    outline-offset: -8px;
  }

  .combo-cta__heading {
    position: relative;
    z-index: 1;

    /* 360px of a 720px tile: half its width, so the heading wraps the same
       way at any size. */
    width: 50%;
    margin: 0;
    font-family: var(--font-stack-display);
    font-size: var(--type-size-display-mobile);
    font-weight: 400;
    line-height: 1;
    text-align: center;
    overflow-wrap: break-word;

    @media screen and (min-width: 750px) {
      font-size: var(--type-size-display);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Combo CTA",
  "tag": "section",
  "class": "combo-cta-section",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Lorem Ipsum"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "info": "Shown when there's no image.",
          "default": "#D9D9D9"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combo CTA",
      "category": "Custom modules",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}

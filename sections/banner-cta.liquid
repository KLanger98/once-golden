{% comment %}
  Banner CTA: a full-bleed image banner with an outlined button centred along
  the bottom edge. The image keeps the design's 1440 × 400 proportions so any
  lettering baked into it stays whole; on small screens an optional mobile
  image can take over.

  Lives under "Custom modules" in the theme editor's Add section picker.
{% endcomment %}

{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: image
-%}

<div
  class="banner-cta"
  style="
    --banner-cta-background: {{ section.settings.background_color }};
    --banner-cta-text: {{ section.settings.text_color }};
  "
>
  {%- if image != blank -%}
    <picture>
      <source
        media="(min-width: 750px)"
        srcset="{{ image | image_url: width: 1440 }} 1440w, {{ image | image_url: width: 2160 }} 2160w, {{ image | image_url: width: 2880 }} 2880w"
        sizes="100vw"
      >
      {{
        mobile_image
        | image_url: width: 1500
        | image_tag:
          class: 'banner-cta__image',
          loading: 'lazy',
          alt: image.alt,
          sizes: '100vw',
          widths: '750, 1100, 1500'
      }}
    </picture>
  {%- endif -%}

  {%- if section.settings.button_label != blank -%}
    {%- liquid
      assign tag = 'span'
      if section.settings.button_link != blank
        assign tag = 'a'
      endif
    -%}
    <{{ tag }}
      {% if section.settings.button_link != blank %}
        href="{{ section.settings.button_link }}"
      {% endif %}
      class="banner-cta__button"
    >
      {{- section.settings.button_label -}}
    </{{ tag }}>
  {%- endif -%}
</div>

{% stylesheet %}
  .banner-cta {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;

    /* An explicit width stops min-height widening the banner through the
       aspect ratio; below ~860px the min-height wins and the image crops. */
    width: 100%;
    aspect-ratio: 1440 / 400;
    min-height: 240px;
    padding: 20px var(--grid-margin);
    overflow: hidden;
    background-color: var(--banner-cta-background);
    color: var(--banner-cta-text);
  }

  .banner-cta__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner-cta__button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 340px;
    max-width: 100%;
    padding: 10px;
    border: 1px solid currentColor;
    color: inherit;
    font-family: var(--font-stack-areal);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      color var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  a.banner-cta__button:hover,
  a.banner-cta__button:focus-visible {
    background-color: var(--banner-cta-text);
    color: var(--banner-cta-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner CTA",
  "tag": "section",
  "class": "banner-cta-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown at 1440 × 400 proportions."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Used below 750px, where the banner crops to fit a taller shape."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "DRINKS CLUB"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Shown behind the image while it loads, or when there's no image.",
      "default": "#FF89A9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Button color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Banner CTA",
      "category": "Custom modules"
    }
  ]
}
{% endschema %}
